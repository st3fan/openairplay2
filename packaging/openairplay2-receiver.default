# Configuration for the openairplay2-receiver service. Every option of the
# daemon is one variable here; a line left commented out (or a variable left
# empty) means the built-in default. Run `openairplay2-receiver --help` for
# details, and `systemctl restart openairplay2-receiver` after editing.
#
# This file is root-owned and mode 0640 because it can hold secrets. They are
# passed to the daemon as environment variables, not command-line arguments,
# so unlike a --pincode flag they are not visible to other users in `ps`.

# Name senders see in the AirPlay menu. %h becomes this machine's hostname,
# so one file can be deployed unedited across several machines. The default
# already includes the hostname.
#OPENAIRPLAY2_NAME=OpenAirPlay2 (%h)

# ALSA playback device; `openairplay2-receiver --list-devices` lists them.
#OPENAIRPLAY2_ALSA_DEVICE=default

# Drive this ALSA mixer control from the sender's volume instead of scaling
# samples in software (hardware volume); `openairplay2-receiver
# --list-mixers` lists the controls. NAME, or NAME,INDEX.
#OPENAIRPLAY2_MIXER=

# Mixer device holding that control (default: the card of the ALSA device
# above, else "default").
#OPENAIRPLAY2_MIXER_DEVICE=

# Require this code to pair. Without one, any device on the network can pair.
#OPENAIRPLAY2_PINCODE=

# Control port.
#OPENAIRPLAY2_PORT=7000

# Advertise over mDNS (on/off).
#OPENAIRPLAY2_AVAHI=on

# Open the ALSA device (on/off); off decodes without playing.
#OPENAIRPLAY2_AUDIO=on

# Device id in the advertisement (default: from a real network interface).
#OPENAIRPLAY2_MAC=

# The local now-playing socket that openairplay2-tui connects to by default.
# Served at /run/openairplay2/tui.sock unless this names another path; "off"
# serves none. Any local user may connect — the socket file's permissions
# are the access control.
#OPENAIRPLAY2_TUI_SOCKET=/run/openairplay2/tui.sock

# Also serve the now-playing WebSocket over TCP, for a display on another
# machine, e.g. 127.0.0.1:7392. It carries track metadata and cover art, so
# keep it on loopback unless you mean otherwise.
#OPENAIRPLAY2_TUI_LISTEN=

# Require this password on the now-playing WebSocket; openairplay2-tui
# presents it with --password (or this same variable). Without one, anyone
# who can reach the address connects.
#OPENAIRPLAY2_TUI_PASSWORD=

# Log verbosity: error, warn, info, debug or trace. debug is the full
# protocol trace (every request, bodies hex-dumped — very chatty while
# playing).
#OPENAIRPLAY2_LOG_LEVEL=info

# OPENAIRPLAY2_IDENTITY_FILE is set by the systemd unit (--identity-file,
# which wins) and should not be set here.

# RUST_LOG overrides OPENAIRPLAY2_LOG_LEVEL for per-module control, e.g.
# RUST_LOG=openairplay2::session=trace.
#RUST_LOG=
